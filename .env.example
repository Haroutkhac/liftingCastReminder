# Required - LiftingCast meet credentials
MEET_ID=your_meet_id
MEET_PASSWORD=your_meet_password
API_KEY=your_api_key

# Required - Lifter name to track (partial match, case-insensitive)
TRACK_LIFTER=Lifter Name

# Optional - Override WebSocket URL (defaults to wss://backup.liftingcast.com/websocket)
# LIFTINGCAST_URL=wss://backup.liftingcast.com/websocket

# Set by Railway automatically
# PORT=3000
